# Safe example only. Do not commit real values.

# Optional: override which ZCode credential store to read.
# Usually leave unset so the client uses:
# %USERPROFILE%\.zcode\v2\credentials.json
# ZCODE_CREDENTIALS_FILE=C:\Users\YourUser\.zcode\v2\credentials.json

# Optional: custom secret if your credential store was created with one.
# Do not share or commit this.
# ZCODE_CREDENTIAL_SECRET=

# Optional: process-only token override.
# Use only locally. Do not log, commit, screenshot, or share.
# ZCODE_START_PLAN_TOKEN=
# ZCODE_JWT_TOKEN=

# Optional device id override.
# Usually leave unset.
# ZCODE_DEVICE_MID=

# Optional default GLM thinking level for direct/proxy calls.
# Accepted values: low, high, max
# ZCODE_THINKING_LEVEL=max
# ZCODE_PROXY_THINKING_LEVEL=max
# ZCODE_CLAUDE_THINKING_LEVEL=max

# Optional proxy dump folders for debugging.
# Review before sharing because dumps contain prompts/tool outputs.
# ZCODE_PROXY_DUMP_DIR=proxy-dumps
# ZCODE_CLAUDE_PROXY_DUMP_DIR=claude-proxy-dumps

# Optional local key for protecting the OpenAI-compatible proxy.
# This is NOT your ZCode token. It is only checked by openai_proxy.py.
# ZCODE_PROXY_API_KEY=

# Optional diagnostics directory for OpenAI proxy request/response dumps.
# ZCODE_PROXY_DUMP_DIR=

# Optional local key for protecting the Claude-compatible proxy.
# This is NOT your ZCode token. It is only checked by claude_proxy.py.
# ZCODE_CLAUDE_PROXY_API_KEY=

# Optional diagnostics directory for Claude proxy request/response dumps.
# ZCODE_CLAUDE_PROXY_DUMP_DIR=
